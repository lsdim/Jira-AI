{
  "manifest_version": 3,
  "name": "Jira AI Helper",
  "version": "1.6",
  "description": "Автоматизація закриття заявок Jira за допомогою Gemini AI",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://jira.ukrposhta.loc/*",
    "https://docs.google.com/spreadsheets/*"
  ],
  "action": {
    "default_popup": "options.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://jira.ukrposhta.loc/browse/*", "https://jira.ukrposhta.loc/projects/*"],
      "js": ["defaults.js", "sheets.js", "highlighter.js", "attachments.js", "content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}