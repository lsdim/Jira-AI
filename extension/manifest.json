{
  "manifest_version": 3,
  "name": "Jira AI Helper (Gemini)",
  "version": "1.2",
  "description": "Автоматизація закриття заявок Jira за допомогою Gemini AI",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://jira.ukrposhta.loc/*",
    "https://docs.google.com/spreadsheets/*"
  ],
  "action": {
    "default_popup": "options.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jira-ai-helper@lsdim",
      "update_url": "https://raw.githubusercontent.com/lsdim/Jira-AI/master/update.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://jira.ukrposhta.loc/browse/*", "https://jira.ukrposhta.loc/projects/*"],
      "js": ["defaults.js", "sheets.js", "content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  }
}